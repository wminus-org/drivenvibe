{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "drivenvibe-site",
  "compatibility_date": "2026-07-14",
  // Assets-only worker, no code. Deploy (from repo root):
  //   npm run deploy:site   (runs build:site first; site/demo/ is a build output)
  "assets": {
    "directory": "../../site"
  },
  "routes": [
    { "pattern": "drivenvibe.com", "custom_domain": true },
    { "pattern": "www.drivenvibe.com", "custom_domain": true }
  ]
}
