{
  "name": "drivenvibe",
  "version": "0.2.0",
  "description": "Voice-first phone remote for Claude Code and Codex. Runs the desktop companion.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wminus-org/drivenvibe.git"
  },
  "homepage": "https://drivenvibe.com",
  "keywords": [
    "claude-code",
    "codex",
    "voice",
    "pwa",
    "remote"
  ],
  "bin": {
    "drivenvibe": "bin/drivenvibe.mjs"
  },
  "files": [
    "bin/",
    "dist/server/",
    "dist/pwa/",
    "config.example.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "node --import tsx --watch src/server/index.ts",
    "dev:pwa": "vite",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:cloud": "vite build --mode cloud",
    "deploy:site": "npm run build:site && wrangler deploy --config workers/site/wrangler.jsonc",
    "start": "npm run build && tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build:cloud && npm run build:site && npm run build && npm run build:server",
    "prepack": "npm run build && npm run build:server"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "^3.26.3",
    "@clerk/clerk-js": "^6.41.0",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
